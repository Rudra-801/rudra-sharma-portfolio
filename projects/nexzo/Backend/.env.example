NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://personalized-recommendersystem.web.app,https://personalized-recommendersystem.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=
# Set only to a model enabled for this Gemini project. Code cannot restore quota.
GEMINI_MODEL=gemini-3.8-flash
# Text provider priority is Groq -> OpenAI -> Gemini. Only fully configured providers are attempted.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional, supported by the configured model. No automatic model fallback.
OPENAI_REASONING_EFFORT=none
